{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sayrhazi.local/schema/sayrhazi.schema.json",
  "title": "Sayrhazi project configuration",
  "description": "Contrat de .opencode/sayrhazi.yaml : cles requises, types et valeurs fermees. Reference normative du noyau.",
  "type": "object",
  "required": ["workflow", "project", "agents", "technical", "commands", "quality"],
  "properties": {
    "workflow": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "Sayrhazi"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "not": {"const": "A_COMPLETER"}},
        "description": {"type": "string"},
        "type": {"enum": ["application", "website", "api", "library", "other"]}
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "required": ["architect", "builder", "reviewer", "security", "qa"],
      "properties": {
        "architect": {"type": "string", "minLength": 1},
        "builder": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "security": {"type": "string", "minLength": 1},
        "qa": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "technical": {
      "type": "object",
      "required": ["language", "framework", "database_type", "database_driver", "database_name", "package_manager"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "framework": {"type": "string", "minLength": 1},
        "database_type": {"enum": ["postgresql", "mongodb", "sqlite", "mysql", "none"]},
        "database_driver": {"enum": ["sequelize", "prisma", "typeorm", "pg", "mongoose", "knex", "drizzle", "none"]},
        "database_name": {"type": ["string", "null"]},
        "package_manager": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": ["install", "dev", "build", "test", "lint"],
      "properties": {
        "install": {"type": "string", "minLength": 1},
        "dev": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "lint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["local_url"],
      "properties": {
        "local_url": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["security_audit_required_by_default", "visual_qa_required", "required_checks"],
      "properties": {
        "security_audit_required_by_default": {"type": "boolean"},
        "visual_qa_required": {"type": "boolean"},
        "required_checks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": ["docker_required", "docker_reason", "playwright_available"],
      "properties": {
        "docker_required": {"type": "boolean"},
        "docker_reason": {"type": ["string", "null"]},
        "playwright_available": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
